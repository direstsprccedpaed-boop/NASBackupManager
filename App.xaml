<Application x:Class="NasBackupManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Palette Nexus -->
            <Color x:Key="Bg">#1C1B19</Color>
            <Color x:Key="Header">#171614</Color>
            <Color x:Key="Surface">#252422</Color>
            <Color x:Key="Surface2">#2D2C2A</Color>
            <Color x:Key="Border">#393836</Color>

            <Color x:Key="Text">#CDCCCA</Color>
            <Color x:Key="Muted">#797876</Color>

            <Color x:Key="Accent">#4F98A3</Color>
            <Color x:Key="Success">#6DAA45</Color>
            <Color x:Key="Warning">#FDAB43</Color>
            <Color x:Key="Danger">#DD6974</Color>

            <Color x:Key="Nas1">#4F98A3</Color>
            <Color x:Key="Nas2">#A78BFA</Color>
            <Color x:Key="Backup">#6DAA45</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
            <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource Header}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />

            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />

            <SolidColorBrush x:Key="Nas1Brush" Color="{StaticResource Nas1}" />
            <SolidColorBrush x:Key="Nas2Brush" Color="{StaticResource Nas2}" />
            <SolidColorBrush x:Key="BackupBrush" Color="{StaticResource Backup}" />

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0" />

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3A3936" />
                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#4A4945" />
                    </Trigger>

                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryButton"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3A7E87" />
                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#28616A" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DangerButton"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />

                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#3A4747" />
                    </Trigger>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#302F2D" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>