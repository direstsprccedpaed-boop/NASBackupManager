<Window x:Class="NasBackupManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NAS Backup Manager"
        Width="1380"
        Height="860"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="31"
                            Height="31"
                            CornerRadius="8"
                            Background="{StaticResource AccentBrush}"
                            Margin="0,0,12,0">

                        <TextBlock Text="N"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel>
                        <TextBlock Text="NAS BACKUP MANAGER"
                                   FontWeight="SemiBold"
                                   FontSize="15" />

                        <TextBlock Text="Analyse, fiabilise et sauvegarde vos médias"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <CheckBox Grid.Column="1"
                          Content="Dry Run — simulation sans écriture"
                          IsChecked="{Binding DryRun}"
                          Foreground="{StaticResource WarningBrush}"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Zone principale -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barre latérale -->
            <Border Grid.Column="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14">

                <StackPanel>
                    <TextBlock Text="ACTIONS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="10,9" />

                    <Button Content="⌕   Analyser les sources"
                            Command="{Binding ScanCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,0,12" />

                    <TextBlock Text="L'analyse alimente automatiquement la file de copie avec les médias qui n'existent pas encore dans la destination."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="10,10,10,0" />
                </StackPanel>
            </Border>

            <TabControl Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="24,20">

                <!-- Dashboard -->
                <TabItem Header="  Dashboard  ">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Tableau de contrôle"
                                       FontSize="27"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Une vue claire sur les sources, les doublons et les éléments à sauvegarder."
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,18" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="10"
                                        Padding="18"
                                        Margin="0,0,12,0">

                                    <StackPanel>
                                        <TextBlock Text="FICHIERS ANALYSÉS"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />

                                        <TextBlock Text="{Binding FilesFound}"
                                                   FontSize="29"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="10"
                                        Padding="18"
                                        Margin="6,0">

                                    <StackPanel>
                                        <TextBlock Text="GROUPES DOUBLONS"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />

                                        <TextBlock Text="{Binding DuplicateCount}"
                                                   FontSize="29"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="10"
                                        Padding="18"
                                        Margin="12,0,0,0">

                                    <StackPanel>
                                        <TextBlock Text="À SAUVEGARDER"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />

                                        <TextBlock Text="{Binding NewFilesCount}"
                                                   FontSize="29"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="10"
                                Padding="8"
                                Margin="0,20,0,0">

                            <ListView ItemsSource="{Binding Files}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nom"
                                                        Width="315"
                                                        DisplayMemberBinding="{Binding FileName}" />

                                        <GridViewColumn Header="Titre détecté"
                                                        Width="235"
                                                        DisplayMemberBinding="{Binding Parsed.Title}" />

                                        <GridViewColumn Header="Année"
                                                        Width="70"
                                                        DisplayMemberBinding="{Binding YearLabel}" />

                                        <GridViewColumn Header="Qualité"
                                                        Width="85"
                                                        DisplayMemberBinding="{Binding ResolutionLabel}" />

                                        <GridViewColumn Header="Source"
                                                        Width="90"
                                                        DisplayMemberBinding="{Binding SourceLabel}" />

                                        <GridViewColumn Header="Taille"
                                                        Width="95"
                                                        DisplayMemberBinding="{Binding SizeLabel}" />

                                        <GridViewColumn Header="Fiabilité"
                                                        Width="95"
                                                        DisplayMemberBinding="{Binding ConfidenceLabel}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Sources -->
                <TabItem Header="  Sources  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20"
                                    MaxWidth="900">

                            <TextBlock Text="Sources de données"
                                       FontSize="27"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Les lecteurs locaux et chemins réseau UNC sont pris en charge."
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,20" />

                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="NAS principal"
                                               Foreground="{StaticResource MutedBrush}" />

                                    <DockPanel Margin="0,6,0,18">
                                        <Button DockPanel.Dock="Right"
                                                Content="Parcourir"
                                                Command="{Binding BrowseNas1Command}"
                                                Margin="8,0,0,0" />

                                        <TextBox Text="{Binding Nas1Path, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>

                                    <TextBlock Text="NAS secondaire"
                                               Foreground="{StaticResource MutedBrush}" />

                                    <DockPanel Margin="0,6,0,18">
                                        <Button DockPanel.Dock="Right"
                                                Content="Parcourir"
                                                Command="{Binding BrowseNas2Command}"
                                                Margin="8,0,0,0" />

                                        <TextBox Text="{Binding Nas2Path, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>

                                    <TextBlock Text="Destination de sauvegarde"
                                               Foreground="{StaticResource MutedBrush}" />

                                    <DockPanel Margin="0,6,0,22">
                                        <Button DockPanel.Dock="Right"
                                                Content="Parcourir"
                                                Command="{Binding BrowseBackupCommand}"
                                                Margin="8,0,0,0" />

                                        <TextBox Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>

                                    <Button Content="Lancer l'analyse"
                                            Command="{Binding ScanCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Copie -->
                <TabItem Header="  Copie &amp; reprise  ">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Copie contrôlée"
                                       FontSize="27"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Écriture dans un fichier .partial, validation de taille puis renommage final. Les échecs peuvent être relancés."
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,18" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="10"
                                Padding="8">

                            <ListView ItemsSource="{Binding CopyQueue}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Fichier"
                                                        Width="330"
                                                        DisplayMemberBinding="{Binding FileName}" />

                                        <GridViewColumn Header="Source"
                                                        Width="80"
                                                        DisplayMemberBinding="{Binding Source}" />

                                        <GridViewColumn Header="Destination"
                                                        Width="410"
                                                        DisplayMemberBinding="{Binding Destination}" />

                                        <GridViewColumn Header="Taille"
                                                        Width="90"
                                                        DisplayMemberBinding="{Binding Size}" />

                                        <GridViewColumn Header="État"
                                                        Width="100"
                                                        DisplayMemberBinding="{Binding StatusLabel}" />

                                        <GridViewColumn Header="Erreur"
                                                        Width="220"
                                                        DisplayMemberBinding="{Binding Error}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,14,0,0">

                            <Button Content="Exécuter la file"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CopyCommand}" />

                            <Button Content="Relancer les échecs"
                                    Command="{Binding RetryFailedCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Diagnostic -->
                <TabItem Header="  Diagnostic  ">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Diagnostic en temps réel"
                                       FontSize="27"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Les dossiers inaccessibles, erreurs de lecture et incidents de copie sont conservés ici au lieu d'être ignorés."
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,18" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="10"
                                Padding="8">

                            <ListView ItemsSource="{Binding Diagnostics}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Heure"
                                                        Width="165"
                                                        DisplayMemberBinding="{Binding Timestamp}" />

                                        <GridViewColumn Header="Niveau"
                                                        Width="90"
                                                        DisplayMemberBinding="{Binding Level}" />

                                        <GridViewColumn Header="Module"
                                                        Width="110"
                                                        DisplayMemberBinding="{Binding Area}" />

                                        <GridViewColumn Header="Message"
                                                        Width="360"
                                                        DisplayMemberBinding="{Binding Message}" />

                                        <GridViewColumn Header="Chemin"
                                                        Width="410"
                                                        DisplayMemberBinding="{Binding Path}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Row="2"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid Margin="20,0">
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />

                <Button Content="Annuler"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="10,4" />
            </Grid>
        </Border>
    </Grid>
</Window>